# ── Pinecone ──────────────────────────────────────────────────────────────────
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=jwellos

# ── Python service ─────────────────────────────────────────────────────────────
# Port the FastAPI service listens on (default 8000)
PORT=8000

# ── Next.js (set this in Vercel env vars or .env.local) ──────────────────────
# URL where the Python service is reachable from the Next.js server
# Local dev:  http://localhost:8000
# Render:     https://your-service-name.onrender.com
CLIP_SERVICE_URL=http://localhost:8000
